generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Categories ───────────────────────────────────────────
model Category {
  id            String    @id @default(cuid())
  name          String    @unique
  nameAr        String?
  nameKu        String?
  nameKm        String?
  slug          String    @unique
  description   String?   @db.Text
  descriptionAr String?   @db.Text
  descriptionKu String?   @db.Text
  descriptionKm String?   @db.Text
  image         String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

// ─── Brands ───────────────────────────────────────────────
model Brand {
  id            String    @id @default(cuid())
  name          String    @unique
  nameAr        String?
  nameKu        String?
  nameKm        String?
  slug          String    @unique
  descriptionAr String?   @db.Text
  descriptionKu String?   @db.Text
  descriptionKm String?   @db.Text
  logo          String?
  website   String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("brands")
}

// ─── Products ─────────────────────────────────────────────
model Product {
  id            String   @id @default(cuid())
  name          String
  nameAr        String?
  nameKu        String?
  nameKm        String?
  slug          String   @unique
  description   String?  @db.Text
  descriptionAr String?  @db.Text
  descriptionKu String?  @db.Text
  descriptionKm String?  @db.Text
  longDescription   String?  @db.Text
  longDescriptionAr String?  @db.Text
  longDescriptionKu String?  @db.Text
  longDescriptionKm String?  @db.Text
  price         Float
  originalPrice Float?
  currency      String   @default("IQD")
  image         String
  images        String?  @db.Text  // JSON array of image URLs
  categoryId    String
  brandId       String?
  isBestSeller  Boolean  @default(false)
  isFeatured    Boolean  @default(false)
  isNew         Boolean  @default(false)
  inStock       Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  colors        ProductColor[]

  category Category @relation(fields: [categoryId], references: [id])
  brand    Brand?   @relation(fields: [brandId], references: [id])

  @@index([categoryId])
  @@index([brandId])
  @@index([isBestSeller])
  @@index([isFeatured])
  @@map("products")
}

model ProductColor {
  id        String   @id @default(cuid())
  productId String
  name      String   // e.g., "Green", "White"
  colorCode String   // e.g., "#00FF00"
  image     String
  
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@index([productId])
  @@map("product_colors")
}

// ─── Hero Slides ──────────────────────────────────────────
model HeroSlide {
  id          String   @id @default(cuid())
  title       String?
  subtitle    String?
  description String?  @db.Text
  textEn      String?  @db.Text
  textAr      String?  @db.Text
  textKu      String?  @db.Text
  textKm      String?  @db.Text
  image       String
  mobileImage String?
  buttonText  String?
  buttonLink  String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("hero_slides")
}

// ─── Site Settings ────────────────────────────────────────
model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text

  @@map("site_settings")
}

// ─── Brewing Methods ──────────────────────────────────────
model BrewingMethod {
  id            String   @id @default(cuid())
  name          String
  nameAr        String?
  nameKu        String?
  nameKm        String?
  tagline       String?
  taglineAr     String?
  taglineKu     String?
  taglineKm     String?
  description   String?  @db.Text
  descriptionAr String?  @db.Text
  descriptionKu String?  @db.Text
  descriptionKm String?  @db.Text
  image         String?
  time          String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("brewing_methods")
}

// ─── News Articles ──────────────────────────────────────────
model NewsArticle {
  id            String   @id @default(cuid())
  
  tag           String
  tagAr         String?
  tagKu         String?
  tagKm         String?
  
  title         String
  titleAr       String?
  titleKu       String?
  titleKm       String?
  
  excerpt       String   @db.Text
  excerptAr     String?  @db.Text
  excerptKu     String?  @db.Text
  excerptKm     String?  @db.Text
  
  image         String
  images        String?  @db.Text
  
  isFeatured    Boolean  @default(false)
  sortOrder     Int      @default(0)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("news_articles")
}

// ─── Orders ─────────────────────────────────────────────────
model Order {
  id              String      @id @default(cuid())
  referenceId     String      @unique
  customerName    String
  phone           String
  city            String
  address         String
  totalAmount     Float
  status          String      @default("PENDING") // PENDING, PAID, FAILED, CANCELLED
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  productName String
  price       Float
  quantity    Int
  color       String?

  @@index([orderId])
  @@map("order_items")
}

